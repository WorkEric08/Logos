rules_version = '2';
// Logos: cada pessoa só lê e escreve o que é dela, em users/{uid}/... Tudo o mais fica fechado.
// (A validação do formato de cada documento entra na Fase 5, com testes no emulador.)
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{documento=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /{outro=**} {
      allow read, write: if false;
    }
  }
}
